//| mill-version: 1.1.8
//| mill-jvm-version: temurin:26.0.1
//| mill-jvm-index-version: latest.release
//| mvnDeps: ["com.goyeau::mill-scalafix::0.6.2", "com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION"]

package build

import mill.*
import mill.scalalib.*
import com.goyeau.mill.scalafix.ScalafixModule
import mill.contrib.scoverage.ScoverageModule
import mill.contrib.scoverage.ScoverageReport
import mill.javalib.TestModule.Munit

trait MyModule extends ScalaModule with ScoverageModule with ScalafixModule {
  override def scalaVersion = "3.9.0"

  override def scoverageVersion: T[String] = "2.5.2"

  override def jvmVersion: T[String] = "temurin:26.0.1"

  override def jvmIndexVersion: T[String] = "latest.release"

  private def isInCI: T[Boolean] = Task.Input { Task.env.contains("CI") }

  private def ciScalacOptions: T[Seq[String]] = Task {
    if (isInCI()) {
      Seq(
        "-Werror"
      )
    } else {
      Seq.empty
    }
  }

  override def scalacOptions: T[Seq[String]] = super.scalacOptions() ++ Seq(
    "-source:future",
    "-Wunused:all",
    "-encoding",
    "utf8"
  ) ++ ciScalacOptions()

  trait MyTestModule
      extends ScalaTests
      with TestModule.Munit
      with ScoverageTests
      with ScalafixModule {
    override def munitVersion: T[String] = "1.3.4"
  }
}

object scoverage extends ScoverageReport {
  override def scalaVersion = "3.9.0"

  override def scoverageVersion = "2.5.2"
}
